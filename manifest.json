{
  "manifest_version": 3,
  "name": "开发者工具箱",
  "version": "1.3.3",
  "description": "集成 JSON 格式化、时间戳转换、编码解码、颜色实验室、进制转换与密码随机生成器的轻量级开发者工具",
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "background": { "service_worker": "transfer-background.js" },
  "permissions": [
    "clipboardWrite",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
